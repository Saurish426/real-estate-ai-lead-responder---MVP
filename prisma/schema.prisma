generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// A user can represent an owner, admin, or future team member in the app.
model User {
  id           Int       @id @default(autoincrement())
  agentId      Int?
  officeId     Int?
  name         String
  email        String    @unique
  passwordHash String    @default("")
  passwordSalt String    @default("")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  agent        Agent?    @relation(fields: [agentId], references: [id])
  office       Office?   @relation(fields: [officeId], references: [id])
  sessions     Session[]

  @@index([agentId])
  @@index([officeId])
}

// A session stores a hashed login token for a user.
model Session {
  id        String   @id
  tokenHash String   @unique
  userId    Int
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// An agent owns leads, conversations, and settings. Auth can be added later.
model Agent {
  id           Int            @id @default(autoincrement())
  officeId     Int            @default(1)
  name         String
  email        String         @default("")
  phone        String         @default("")
  businessName String         @default("Real Estate Team")
  teamRole     String         @default("agent")
  isActive     Boolean        @default(true)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  office       Office         @relation(fields: [officeId], references: [id])
  leads        Lead[]
  assignedLeads Lead[]        @relation("AssignedAgent")
  conversations Conversation[]
  settings     AgentSettings?
  users        User[]
  leadNotes    LeadNote[]
  followUpReminders FollowUpReminder[]

  @@index([officeId])
  @@index([isActive])
}

// A lead is a potential real estate client who contacts the business.
model Lead {
  id        Int      @id @default(autoincrement())
  agentId   Int      @default(1)
  officeId  Int      @default(1)
  assignedAgentId Int?
  name      String
  email     String
  phone     String
  message   String
  source    String
  crmStatus String   @default("New")
  archived  Boolean  @default(false)
  aiExtraction Json?
  aiIntelligence Json?
  leadScore Int?
  leadScoreLabel String?
  sentiment String?
  urgency String?
  preferredLanguage String @default("en")
  emailSent Boolean @default(false)
  agentNotificationSent Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  agent     Agent    @relation(fields: [agentId], references: [id])
  office    Office   @relation(fields: [officeId], references: [id])
  assignedAgent Agent? @relation("AssignedAgent", fields: [assignedAgentId], references: [id])
  notes     LeadNote[]
  followUpReminders FollowUpReminder[]

  @@index([email])
  @@index([agentId])
  @@index([officeId])
  @@index([assignedAgentId])
  @@index([crmStatus])
  @@index([archived])
  @@index([leadScore])
  @@index([sentiment])
  @@index([urgency])
}

// A LeadNote stores agent-entered CRM notes for a lead.
model LeadNote {
  id        Int      @id @default(autoincrement())
  agentId   Int      @default(1)
  officeId  Int      @default(1)
  leadId    Int
  body      String
  createdAt DateTime @default(now())
  agent     Agent    @relation(fields: [agentId], references: [id])
  office    Office   @relation(fields: [officeId], references: [id])
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([agentId])
  @@index([officeId])
  @@index([leadId])
  @@index([createdAt])
}

// A conversation stores the latest message and status for a lead follow-up.
model Conversation {
  id               Int     @id @default(autoincrement())
  agentId          Int     @default(1)
  officeId         Int     @default(1)
  leadId           Int
  lastMessage      String
  status           String
  messageCount     Int     @default(0)
  aiSummary        String?
  longTermMemory   String?
  followUpRecommendation String?
  bookingStatus    String  @default("none")
  bookingRequested Boolean @default(false)
  bookingLinkSent  Boolean @default(false)
  calendarEventId  String?
  calendarEventLink String?
  followUpReminderAt DateTime?
  followUpReminderStatus String?
  agent            Agent   @relation(fields: [agentId], references: [id])
  office           Office  @relation(fields: [officeId], references: [id])

  @@index([leadId])
  @@index([agentId])
  @@index([officeId])
}

// A booking stores an appointment time and status for a lead.
model Booking {
  id     Int      @id @default(autoincrement())
  leadId Int
  time   DateTime
  status String
}

// FollowUpReminder stores future reminders for agents to follow up with leads.
model FollowUpReminder {
  id             Int       @id @default(autoincrement())
  agentId        Int       @default(1)
  officeId       Int       @default(1)
  leadId         Int
  conversationId Int?
  reminderType   String    @default("lead_follow_up")
  status         String    @default("scheduled")
  message        String
  scheduledFor   DateTime
  sentAt         DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  agent          Agent     @relation(fields: [agentId], references: [id])
  office         Office    @relation(fields: [officeId], references: [id])
  lead           Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([agentId])
  @@index([officeId])
  @@index([leadId])
  @@index([scheduledFor])
  @@index([status])
}

// Organization is a future-ready parent for multiple offices.
model Organization {
  id        Int      @id @default(autoincrement())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  offices   Office[]
}

// Office groups agents, settings, branding, and shared team lead data.
model Office {
  id             Int      @id @default(autoincrement())
  organizationId Int     @default(1)
  name           String   @default("Demo Office")
  officeEmail    String   @default("")
  phone          String   @default("")
  brandName      String   @default("Real Estate Team")
  logoUrl        String   @default("")
  primaryColor   String   @default("#2563eb")
  secondaryColor String   @default("#0f172a")
  websiteUrl     String   @default("")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id])
  agents         Agent[]
  users          User[]
  leads          Lead[]
  conversations  Conversation[]
  leadNotes      LeadNote[]
  followUpReminders FollowUpReminder[]

  @@index([organizationId])
}

// AgentSettings stores the simple business profile used by the AI reply writer.
model AgentSettings {
  id                 Int      @id
  agentId            Int      @unique @default(1)
  officeId           Int      @default(1)
  agentName          String   @default("AI Lead Responder")
  agentEmail         String   @default("")
  agentPhone         String   @default("")
  businessName       String   @default("Real Estate Team")
  calendarLink       String   @default("")
  preferredReplyTone String   @default("friendly and professional")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  agent              Agent    @relation(fields: [agentId], references: [id])

  @@index([officeId])
}

// EventLog stores non-secret operational events for lead tracking and debugging.
model EventLog {
  id        Int      @id @default(autoincrement())
  eventType String
  agentId   Int?
  officeId  Int?
  leadId    Int?
  message   String
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([eventType])
  @@index([agentId])
  @@index([officeId])
  @@index([leadId])
  @@index([createdAt])
}
