generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// A user can represent an owner, admin, or future team member in the app.
model User {
  id    Int    @id @default(autoincrement())
  name  String
  email String @unique
}

// An agent owns leads, conversations, and settings. Auth can be added later.
model Agent {
  id           Int            @id @default(autoincrement())
  name         String
  email        String         @default("")
  phone        String         @default("")
  businessName String         @default("Real Estate Team")
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  leads        Lead[]
  conversations Conversation[]
  settings     AgentSettings?
}

// A lead is a potential real estate client who contacts the business.
model Lead {
  id        Int      @id @default(autoincrement())
  agentId   Int      @default(1)
  name      String
  email     String
  phone     String
  message   String
  source    String
  aiExtraction Json?
  emailSent Boolean @default(false)
  agentNotificationSent Boolean @default(false)
  createdAt DateTime @default(now())
  agent     Agent    @relation(fields: [agentId], references: [id])

  @@index([email])
  @@index([agentId])
}

// A conversation stores the latest message and status for a lead follow-up.
model Conversation {
  id               Int     @id @default(autoincrement())
  agentId          Int     @default(1)
  leadId           Int
  lastMessage      String
  status           String
  messageCount     Int     @default(0)
  aiSummary        String?
  bookingStatus    String  @default("none")
  bookingRequested Boolean @default(false)
  bookingLinkSent  Boolean @default(false)
  agent            Agent   @relation(fields: [agentId], references: [id])

  @@index([leadId])
  @@index([agentId])
}

// A booking stores an appointment time and status for a lead.
model Booking {
  id     Int      @id @default(autoincrement())
  leadId Int
  time   DateTime
  status String
}

// AgentSettings stores the simple business profile used by the AI reply writer.
model AgentSettings {
  id                 Int      @id
  agentId            Int      @unique @default(1)
  agentName          String   @default("AI Lead Responder")
  agentEmail         String   @default("")
  agentPhone         String   @default("")
  businessName       String   @default("Real Estate Team")
  calendarLink       String   @default("")
  preferredReplyTone String   @default("friendly and professional")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  agent              Agent    @relation(fields: [agentId], references: [id])
}

// EventLog stores non-secret operational events for lead tracking and debugging.
model EventLog {
  id        Int      @id @default(autoincrement())
  eventType String
  agentId   Int?
  leadId    Int?
  message   String
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([eventType])
  @@index([agentId])
  @@index([leadId])
  @@index([createdAt])
}
